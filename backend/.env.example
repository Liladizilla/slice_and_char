# ---------------------------------------------------------
# Copy this file to .env and fill in real values.
# .env is already in .gitignore — never commit real keys.
# ---------------------------------------------------------

# --- Server ---
PORT=3000
FRONTEND_URL=http://localhost:5173

# --- Twilio (SMS to your phone) ---
# Get these from console.twilio.com after creating a trial/paid account
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# This is where every order and payment confirmation gets texted
SHOP_OWNER_PHONE=+254713324135

# --- Firebase Admin (order storage) ---
# From Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the ENTIRE downloaded JSON file as one line here, OR point to a file path (see firebaseAdmin.js)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- IntaSend (M-Pesa + card payments) ---
# From intasend.com dashboard > API Keys. Use sandbox keys while testing.
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_xxxxxxxx
INTASEND_SECRET_KEY=ISSecretKey_test_xxxxxxxx
INTASEND_TEST_MODE=true

# --- Admin dashboard access ---
# Simple shared PIN the admin page asks for before showing orders
ADMIN_PIN=change_this_pin
